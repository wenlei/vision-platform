# ─────────────────────────────────────────────────────────────
# vision-inference : GPU 路线
# 基础镜像 : pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
# 模型     : YOLO11L + CLIP ViT-B/32 + InsightFace buffalo_l
# 数据库   : 外部 PostgreSQL（DB_HOST 环境变量）
# 硬件需求 : NVIDIA GPU >= 8GB VRAM，16GB RAM
# ─────────────────────────────────────────────────────────────
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

RUN apt-get update && apt-get install -y --no-install-recommends 
    libglib2.0-0 libgl1-mesa-glx libgomp1 libpq-dev curl 
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.gpu.txt .
RUN pip install --no-cache-dir -r requirements.gpu.txt

RUN python3 -c "import insightface; app = insightface.app.FaceAnalysis(name='buffalo_l', providers=['CUDAExecutionProvider']); app.prepare(ctx_id=0, det_size=(640,640)); print('InsightFace buffalo_l ready')"
RUN python3 -c "import clip, torch; clip.load('ViT-B/32', device='cuda'); print('CLIP ready')"
RUN python3 -c "from ultralytics import YOLO; YOLO('yolo11l.pt'); print('YOLO11L ready')"

COPY app.py .
COPY static/ ./static/

ENV DEVICE=gpu DB_HOST=192.168.50.118 DB_PORT=5432 DB_USER=postgres DB_NAME=vision_db
ENV IMAGE_STORAGE=retention IMAGE_RETENTION_HOURS=48 NAS_PATH=/app/images API_PORT=8000

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 
    CMD curl -f http://localhost:8000/health || exit 1
CMD ["python3", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
